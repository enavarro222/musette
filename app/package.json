    "@types/web-bluetooth": "^0.0.21",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "wasm": "cargo build -p musette-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/lib/core/wasm ../target/wasm32-unknown-unknown/release/musette_wasm.wasm",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "expo export --platform web && cp dist/index.html dist/404.html",
    "postinstall": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/"
