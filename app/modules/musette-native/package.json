{
  "name": "musette-native",
  "version": "0.1.0",
  "private": true,
  "description": "The Rust core of Musette (crates/musette-ffi) for iOS and Android, generated by uniffi-bindgen-react-native",
  "license": "MIT",
  "main": "src/index.tsx",
  "react-native": "src/index.tsx",
  "types": "src/index.tsx",
  "scripts": {
    "generate:android": "node scripts/generate.mjs android",
    "generate:ios": "node scripts/generate.mjs ios"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "@ubjs/core": "*",
    "uniffi-bindgen-react-native": "*"
  },
  "codegenConfig": {
    "name": "MusetteNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.musettenative"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enavarro222/musette.git"
  }
}
